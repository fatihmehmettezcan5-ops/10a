# ZORUNLU — Neon'dan alınan pooled PostgreSQL bağlantı adresi
DATABASE_URL=postgresql://kullanici:sifre@sunucu/neondb?sslmode=require

# ZORUNLU (üretimde) — ör: openssl rand -base64 48
SESSION_SECRET=buraya-en-az-32-karakter-rastgele-bir-deger

# Sınıf ayarları
CLASS_JOIN_CODE=10A
NEXT_PUBLIC_CLASS_NAME=10/A

# Uygulamanın Netlify adresi (ilk deploy sonrası doldurulabilir)
APP_URL=https://site-adiniz.netlify.app

# YAPAY ZEKÂ — anahtarların üçü de eklenebilir. Varsayılan öncelik:
# Gemini → Groq → OpenRouter → yerleşik motor
# AI_PROVIDER ile ilk tercihi değiştirebilirsin: gemini | groq | openrouter
AI_PROVIDER=gemini

# Google AI Studio — güncel varsayılan: Gemini 3.8 Flash (stable + free tier)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Groq — güncel varsayılan: OpenAI GPT-OSS 120B (production)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — güncel varsayılan: Nex-N2.5-Pro ücretsiz sürümü
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# Model değişkenleri zorunlu değildir. Bir model kapanırsa uygulama aynı sağlayıcıda
# iki güncel yedeği, ardından anahtarı bulunan diğer sağlayıcıları otomatik dener.
